{
    "name": "tally-simple",
    "version": "1.8.1",
    "description": "A small, typed JavaScript client and CLI for querying Tally through TDL definitions.",
    "homepage": "https://keshavsoft.github.io/tally-simple/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/keshavsoft/tally-simple.git"
    },
    "bugs": {
        "url": "https://github.com/keshavsoft/tally-simple/issues"
    },
    "type": "module",
    "exports": {
        ".": {
            "types": "./src/index.d.ts",
            "import": "./src/index.js",
            "default": "./src/index.js"
        },
        "./package.json": "./package.json"
    },
    "bin": {
        "tally-simple": "./bin/tally-simple.js"
    },
    "main": "./src/index.js",
    "types": "./src/index.d.ts",
    "files": [
        "bin",
        "src",
        "docs",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "scripts": {
        "generate:dts": "create-intellisense",
        "test": "node --test test/test.js test/units.js"
    },
    "keywords": [
        "tally",
        "tdl",
        "api",
        "accounting"
    ],
    "license": "MIT",
    "engines": {
        "node": ">=20.10"
    },
    "publishConfig": {
        "access": "public"
    },
    "devDependencies": {
        "create-intellisense": "^1.2.1"
    },
    "dependencies": {
        "@keshavsoft/api-tree": "^11.1.1",
        "@keshavsoft/json-transformer": "^1.7.1",
        "tally-simple-json": "^1.16.3",
        "tally-spec": "^1.0.0"
    }
}
